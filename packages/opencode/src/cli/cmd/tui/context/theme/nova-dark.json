{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "bg": "#0A0A0A",
    "element": "#111111",
    "panel": "#181818",
    "subtle": "#1E1E1E",
    "ink": "#F0F0F0",
    "muted": "#666666",
    "border": "#2A2A2A",
    "accent": "#FF5500",
    "accentSoft": "#FF7733",
    "accentDim": "#3D1A00",
    "green": "#22C55E",
    "yellow": "#EAB308",
    "red": "#EF4444",
    "blue": "#3B82F6"
  },
  "theme": {
    "primary": { "dark": "accent", "light": "accent" },
    "secondary": { "dark": "ink", "light": "ink" },
    "accent": { "dark": "accentSoft", "light": "accentSoft" },
    "error": { "dark": "red", "light": "red" },
    "warning": { "dark": "yellow", "light": "yellow" },
    "success": { "dark": "green", "light": "green" },
    "info": { "dark": "blue", "light": "blue" },
    "text": { "dark": "ink", "light": "ink" },
    "textMuted": { "dark": "muted", "light": "muted" },
    "background": { "dark": "bg", "light": "bg" },
    "backgroundPanel": { "dark": "panel", "light": "panel" },
    "backgroundElement": { "dark": "element", "light": "element" },
    "border": { "dark": "border", "light": "border" },
    "borderActive": { "dark": "accent", "light": "accent" },
    "borderSubtle": { "dark": "border", "light": "border" },
    "diffAdded": { "dark": "green", "light": "green" },
    "diffRemoved": { "dark": "red", "light": "red" },
    "diffContext": { "dark": "muted", "light": "muted" },
    "diffHunkHeader": { "dark": "muted", "light": "muted" },
    "diffHighlightAdded": { "dark": "green", "light": "green" },
    "diffHighlightRemoved": { "dark": "red", "light": "red" },
    "diffAddedBg": { "dark": "accentDim", "light": "accentDim" },
    "diffRemovedBg": { "dark": "#2A1A1A", "light": "#2A1A1A" },
    "diffContextBg": { "dark": "panel", "light": "panel" },
    "diffLineNumber": { "dark": "muted", "light": "muted" },
    "diffAddedLineNumberBg": { "dark": "accentDim", "light": "accentDim" },
    "diffRemovedLineNumberBg": { "dark": "#2A1A1A", "light": "#2A1A1A" },
    "markdownText": { "dark": "ink", "light": "ink" },
    "markdownHeading": { "dark": "accent", "light": "accent" },
    "markdownLink": { "dark": "blue", "light": "blue" },
    "markdownLinkText": { "dark": "accentSoft", "light": "accentSoft" },
    "markdownCode": { "dark": "accentSoft", "light": "accentSoft" },
    "markdownBlockQuote": { "dark": "muted", "light": "muted" },
    "markdownEmph": { "dark": "accentSoft", "light": "accentSoft" },
    "markdownStrong": { "dark": "ink", "light": "ink" },
    "markdownHorizontalRule": { "dark": "border", "light": "border" },
    "markdownListItem": { "dark": "ink", "light": "ink" },
    "markdownListEnumeration": { "dark": "muted", "light": "muted" },
    "markdownImage": { "dark": "blue", "light": "blue" },
    "markdownImageText": { "dark": "muted", "light": "muted" },
    "markdownCodeBlock": { "dark": "ink", "light": "ink" },
    "syntaxComment": { "dark": "muted", "light": "muted" },
    "syntaxKeyword": { "dark": "accent", "light": "accent" },
    "syntaxFunction": { "dark": "blue", "light": "blue" },
    "syntaxVariable": { "dark": "ink", "light": "ink" },
    "syntaxString": { "dark": "green", "light": "green" },
    "syntaxNumber": { "dark": "accentSoft", "light": "accentSoft" },
    "syntaxType": { "dark": "blue", "light": "blue" },
    "syntaxOperator": { "dark": "muted", "light": "muted" },
    "syntaxPunctuation": { "dark": "muted", "light": "muted" }
  }
}
