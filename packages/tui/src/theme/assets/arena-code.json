{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "canvas": "#12110F",
    "surface": "#1A1816",
    "panel": "#201E1B",
    "element": "#26231F",
    "line": "#3A3631",
    "lineSoft": "#2C2926",
    "ink": "#EDE6DC",
    "heading": "#F6F0E7",
    "inkMuted": "#B7AEA2",
    "inkDim": "#A3988C",
    "coral": "#E07A5F",
    "blue": "#9EBFDF",
    "sage": "#8FB89A",
    "sand": "#E0C4A2",
    "rose": "#D47878",
    "lilac": "#C4B4D4",
    "fn": "#F3E7D6",
    "diffAddBg": "#1C2820",
    "diffDelBg": "#2A1F1C"
  },
  "theme": {
    "primary": { "dark": "coral", "light": "coral" },
    "secondary": { "dark": "heading", "light": "heading" },
    "accent": { "dark": "blue", "light": "blue" },
    "error": { "dark": "rose", "light": "rose" },
    "warning": { "dark": "sand", "light": "sand" },
    "success": { "dark": "sage", "light": "sage" },
    "info": { "dark": "blue", "light": "blue" },
    "text": { "dark": "ink", "light": "ink" },
    "textMuted": { "dark": "inkMuted", "light": "inkMuted" },
    "background": { "dark": "canvas", "light": "canvas" },
    "backgroundPanel": { "dark": "panel", "light": "panel" },
    "backgroundElement": { "dark": "element", "light": "element" },
    "border": { "dark": "line", "light": "line" },
    "borderActive": { "dark": "coral", "light": "coral" },
    "borderSubtle": { "dark": "lineSoft", "light": "lineSoft" },
    "diffAdded": { "dark": "sage", "light": "sage" },
    "diffRemoved": { "dark": "rose", "light": "rose" },
    "diffContext": { "dark": "inkDim", "light": "inkDim" },
    "diffHunkHeader": { "dark": "inkMuted", "light": "inkMuted" },
    "diffHighlightAdded": { "dark": "sage", "light": "sage" },
    "diffHighlightRemoved": { "dark": "rose", "light": "rose" },
    "diffAddedBg": { "dark": "diffAddBg", "light": "diffAddBg" },
    "diffRemovedBg": { "dark": "diffDelBg", "light": "diffDelBg" },
    "diffContextBg": { "dark": "surface", "light": "surface" },
    "diffLineNumber": { "dark": "inkDim", "light": "inkDim" },
    "diffAddedLineNumberBg": { "dark": "diffAddBg", "light": "diffAddBg" },
    "diffRemovedLineNumberBg": { "dark": "diffDelBg", "light": "diffDelBg" },
    "markdownText": { "dark": "ink", "light": "ink" },
    "markdownHeading": { "dark": "heading", "light": "heading" },
    "markdownLink": { "dark": "blue", "light": "blue" },
    "markdownLinkText": { "dark": "blue", "light": "blue" },
    "markdownCode": { "dark": "sand", "light": "sand" },
    "markdownBlockQuote": { "dark": "inkMuted", "light": "inkMuted" },
    "markdownEmph": { "dark": "sand", "light": "sand" },
    "markdownStrong": { "dark": "heading", "light": "heading" },
    "markdownHorizontalRule": { "dark": "line", "light": "line" },
    "markdownListItem": { "dark": "blue", "light": "blue" },
    "markdownListEnumeration": { "dark": "coral", "light": "coral" },
    "markdownImage": { "dark": "blue", "light": "blue" },
    "markdownImageText": { "dark": "inkMuted", "light": "inkMuted" },
    "markdownCodeBlock": { "dark": "ink", "light": "ink" },
    "syntaxComment": { "dark": "inkDim", "light": "inkDim" },
    "syntaxKeyword": { "dark": "blue", "light": "blue" },
    "syntaxFunction": { "dark": "fn", "light": "fn" },
    "syntaxVariable": { "dark": "ink", "light": "ink" },
    "syntaxString": { "dark": "sand", "light": "sand" },
    "syntaxNumber": { "dark": "sand", "light": "sand" },
    "syntaxType": { "dark": "lilac", "light": "lilac" },
    "syntaxOperator": { "dark": "inkMuted", "light": "inkMuted" },
    "syntaxPunctuation": { "dark": "inkMuted", "light": "inkMuted" }
  }
}
